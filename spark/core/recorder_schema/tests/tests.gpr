--  Native test project (NOT part of the proof project): differential, exhaustive and fuzz tests of the
--  SPARK sources in ../src.   gprbuild -P tests.gpr -XCONTRACTS=on|off
--    CONTRACTS=on  : assertions enabled (-gnata): every pre/postcondition runs as a run-time check
--                    (loop invariants excluded, see contracts.adc: executing them is quadratic)
--    CONTRACTS=off : assertions disabled: fast, used for the big case files and the benchmark
project Tests is
   type Contracts_Type is ("on", "off");
   Contracts : Contracts_Type := external ("CONTRACTS", "off");

   for Source_Dirs use ("src", "../src");
   for Object_Dir use "obj_" & Contracts;
   for Exec_Dir use "bin_" & Contracts;
   for Create_Missing_Dirs use "True";
   for Main use ("test_recorder_schema.adb");

   package Builder is
      case Contracts is
         when "on"  => for Global_Configuration_Pragmas use "contracts.adc";
         when "off" => null;
      end case;
   end Builder;

   package Compiler is
      case Contracts is
         when "on" =>
            for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-gnatwa", "-gnatVa", "-O1");
         when "off" =>
            for Default_Switches ("Ada") use ("-gnat2022", "-gnato", "-gnatwa", "-gnatVa", "-O2");
      end case;
   end Compiler;
end Tests;
