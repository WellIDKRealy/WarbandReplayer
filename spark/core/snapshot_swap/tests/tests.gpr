--  Native test project (NOT part of the proof project): differential tests and the micro-benchmark
--  of the SPARK sources in ../src.   gprbuild -P tests.gpr -XCONTRACTS=on|off
--    CONTRACTS=on  : assertions enabled (-gnata): every pre/postcondition runs as a run-time check
--    CONTRACTS=off : assertions disabled: fast, used for the exhaustive enumeration and the benchmark
--  The benchmark (bench.adb) is also built with run-time checks suppressed (-gnatp), which is how
--  proven units are compiled for production.
project Tests is
   type Contracts_Type is ("on", "off");
   Contracts : Contracts_Type := external ("CONTRACTS", "off");

   for Source_Dirs use (".", "../src");
   for Object_Dir use "obj_" & Contracts;
   for Exec_Dir use "bin_" & Contracts;
   for Create_Missing_Dirs use "True";
   for Main use ("test_swap.adb", "bench.adb");

   package Compiler is
      case Contracts is
         when "on" =>
            for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-gnatwa", "-gnatwJ", "-gnatVa", "-O1");
         when "off" =>
            for Default_Switches ("Ada") use ("-gnat2022", "-gnato", "-gnatwa", "-gnatwJ", "-gnatVa", "-O2");
      end case;
      --  Production configuration of a proven unit: no run-time checks (the proof replaces them).
      for Switches ("bench.adb") use ("-gnat2022", "-gnatp", "-gnatwa", "-gnatwJ", "-O2");
   end Compiler;
end Tests;
