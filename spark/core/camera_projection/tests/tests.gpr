--  Native test project (NOT part of the proof project): differential + property tests of ../src.
--    gprbuild -P tests.gpr -XCONTRACTS=on|off -XORACLE=<path to oracle.o>
--    CONTRACTS=on  : assertions enabled (-gnata): every pre/postcondition runs as a run-time check.
--                    Built at -O0: GCC 14.2 miscompiles the Status postconditions at -O1/-O2 with -gnata
--                    (its forwprop pass types a PHI of enumeration values as boolean); see PROOF.md.
--    CONTRACTS=off : assertions disabled: fast, used for the big runs
--  The OLD main.c is linked in as oracle.o (built by run_tests.sh with clang -O1 -ffp-contract=off).
--  No -gnatV: NaN / infinity arguments must reach the unit unchecked, exactly as they do from JS.
project Tests is
   type Contracts_Type is ("on", "off");
   Contracts : Contracts_Type := external ("CONTRACTS", "off");
   Oracle    := external ("ORACLE", "bin_oracle/oracle.o");

   for Source_Dirs use ("src", "../src");
   for Object_Dir use "obj_" & Contracts;
   for Exec_Dir use "bin_" & Contracts;
   for Create_Missing_Dirs use "True";
   for Main use ("test_camera_projection.adb", "bench_camera_projection.adb");

   package Compiler is
      case Contracts is
         when "on" =>
            for Default_Switches ("Ada") use
              ("-gnat2022", "-gnata", "-gnato", "-gnatwa", "-O0", "-ffp-contract=off");
         when "off" =>
            for Default_Switches ("Ada") use
              ("-gnat2022", "-gnato", "-gnatwa", "-O2", "-ffp-contract=off");
      end case;
   end Compiler;

   package Linker is
      for Default_Switches ("Ada") use (Oracle, "-lm");
   end Linker;
end Tests;
