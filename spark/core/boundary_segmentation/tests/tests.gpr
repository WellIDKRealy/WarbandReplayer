--  Native differential test program for Boundary_Segmentation (not part of the proof project).
--    gprbuild -P tests.gpr -XMODE=fast        (no contract execution: fast, full workload)
--    gprbuild -P tests.gpr -XMODE=contracts   (-gnata: contracts, loop invariants and the ghost
--                                              specification are EXECUTED; small workload)
project Tests is
   type Mode_Type is ("fast", "contracts");
   Mode : Mode_Type := external ("MODE", "fast");

   for Source_Dirs use ("../src", ".");
   for Main use ("test_segmentation.adb");
   for Object_Dir use "obj/" & Mode;
   for Exec_Dir use "obj/" & Mode;
   for Create_Missing_Dirs use "True";

   package Compiler is
      case Mode is
         when "fast" =>
            for Default_Switches ("Ada") use ("-gnat2022", "-gnato", "-gnatVa", "-gnatwa", "-gnatwJ", "-O2");
         when "contracts" =>
            for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-gnatVa", "-gnatwa", "-gnatwJ", "-O1");
      end case;
   end Compiler;
end Tests;
